{
  "name": "tokerian",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:web": "tsc -b && vite build",
    "electron:dev": "concurrently \"vite\" \"cross-env NODE_ENV=development VITE_DEV_SERVER_URL=http://localhost:5173 electron electron/main.cjs\"",
    "build:desktop": "npm run build:web && electron-builder",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npm run build:web && npx cap sync",
    "cap:open:android": "npx cap open android",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.tokerian.desktop",
    "productName": "Tokerian",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@tanstack/react-virtual": "^3.14.21",
    "hls.js": "^1.7.3",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@types/hls.js": "^0.13.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
